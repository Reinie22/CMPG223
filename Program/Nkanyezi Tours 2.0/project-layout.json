            },
            {
              "id": "accommodation-edit",
              "name": "Add / edit accommodation",
              "file": "Maintain/Accommodation/Edit.aspx",
              "type": "form",
              "fields": [
                { "name": "Name", "label": "Name", "control": "TextBox", "required": true, "maxLength": 120 },
                { "name": "Type", "label": "Type", "control": "TextBox", "placeholder": "Hotel, Guest House, Lodge, Camp", "maxLength": 50 },
                { "name": "Description", "label": "Description", "control": "TextBox", "multiline": true, "maxLength": 1000 },
                { "name": "Address", "label": "Address", "control": "TextBox", "maxLength": 200 },
                { "name": "City", "label": "City", "control": "TextBox", "maxLength": 80 },
                { "name": "ProvinceId", "label": "Province", "control": "DropDownList", "source": "Province" },
                { "name": "StarRating", "label": "Star rating", "control": "DropDownList", "options": ["1", "2", "3", "4", "5"] },
                { "name": "PricePerNight", "label": "Price per night", "control": "TextBox", "inputType": "money", "required": true, "rule": "greater than zero" },
                { "name": "Capacity", "label": "Total capacity (people)", "control": "TextBox", "inputType": "int", "required": true, "rule": "greater than zero" },
                { "name": "Amenities", "label": "Amenities", "control": "TextBox", "multiline": true, "maxLength": 500 }
              ],
              "actions": ["Save", "Cancel"]
            },
            {
              "id": "accommodation-rooms",
              "name": "Rooms",
              "file": "Maintain/Accommodation/Rooms.aspx",
              "type": "childList",
              "purpose": "Manage the rooms belonging to one accommodation",
              "grid": { "columns": ["Room number", "Type", "Beds", "Size", "Own bathroom", "In service"], "actions": ["Edit", "Delete"] },
              "inlineForm": [
                { "name": "RoomNumber", "label": "Room number", "control": "TextBox", "required": true, "maxLength": 20, "rule": "unique within this property" },
                { "name": "RoomType", "label": "Room type", "control": "TextBox", "placeholder": "Single, Double, Family, Suite", "maxLength": 50 },
                { "name": "Beds", "label": "Beds", "control": "TextBox", "inputType": "int", "required": true, "rule": "greater than zero" },
                { "name": "Size", "label": "Size", "control": "TextBox", "placeholder": "30 sqm", "maxLength": 30 },
                { "name": "Bathroom", "label": "Own bathroom", "control": "CheckBox", "default": true },
                { "name": "AvailabilityStatus", "label": "In service", "control": "CheckBox", "default": true }
              ],
              "actions": ["Add room", "Back to accommodation"]
            },
            {
              "id": "accommodation-delete",
              "name": "Delete accommodation",
              "file": "Maintain/Accommodation/Delete.aspx",
              "type": "confirm",
              "actions": ["Confirm delete", "Cancel"]
            }
          ]
        },
        {
          "id": "vehicles",
          "name": "Vehicles (car rental)",
          "roles": ["AD", "SU", "AG"],
          "pages": [
            {
              "id": "vehicles-list",
