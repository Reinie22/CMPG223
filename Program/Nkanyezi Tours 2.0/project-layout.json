    {
      "id": "itineraries",
      "name": "Manage Itineraries",
      "order": 3,
      "inMenu": true,
      "notes": "The centre of the system and the hardest section. Everything else feeds into it.",
      "pages": [
        {
          "id": "itineraries-list",
          "name": "Itinerary list",
          "file": "Itineraries/Default.aspx",
          "type": "list",
          "roles": ["AD", "SU", "AG"],
          "purpose": "All trips. Agents see their own by default",
          "filters": [
            { "name": "TripName", "label": "Trip name contains", "control": "TextBox" },
            { "name": "ClientId", "label": "Client", "control": "DropDownList", "source": "Client users" },
            { "name": "AgentId", "label": "Agent", "control": "DropDownList", "source": "Travel agents" },
            { "name": "Status", "label": "Status", "control": "DropDownList", "source": "ItineraryStatus" }
          ],
          "grid": {
            "columns": ["Trip name", "Client", "Agent", "Dates", "Budget", "Status"],
            "actions": ["Open", "Edit", "Cancel"],
            "rowHint": "Status shown as a coloured badge: Draft grey, Confirmed green, Completed blue, Cancelled red"
          },
          "actions": ["New itinerary", "Export to Excel"]
        },
        {
          "id": "itineraries-unassigned",
          "name": "Unassigned trips",
          "file": "Itineraries/Unassigned.aspx",
          "type": "list",
          "roles": ["AD", "SU", "AG"],
