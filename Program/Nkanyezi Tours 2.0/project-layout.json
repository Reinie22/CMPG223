{
  "$comment": "Nkanyezi Tours - screen inventory for wireframing. Generated from docs/03-app-sections.md and database/01-schema.sql. Field lists match the real database columns, so a wireframe built from this will match what the pages can actually save.",
  "project": {
    "name": "Nkanyezi Tours Information System",
    "module": "CMPG223 / CMPG213",
    "group": "Group 6",
    "client": "Nkanyezi Tours",
    "deadline": "2026-09-30",
    "platform": "ASP.NET Web Forms (.NET Framework 4.8), C#, Visual Studio Design view",
    "database": "Microsoft SQL Server (LocalDB / Express), 18 tables",
    "currency": "ZAR (R)",
    "locale": "en-ZA",
    "dateFormat": "dd MMM yyyy",
    "screenCount": 50
  },

  "designSystem": {
    "cssFramework": "Bootstrap 5",
    "masterPage": "Site.Master",
    "chrome": {
      "topBar": "Brand on the left, section menu across, signed-in user name and Sign out on the right",
      "sectionMenu": ["Dashboard", "Maintain", "Itineraries", "Expenses", "Portal", "Reports"],
      "menuVisibility": "Menu items are hidden when the signed-in role may not open anything inside them",
      "footer": "Group 6 - CMPG223 - Nkanyezi Tours"
    },
    "conventions": {
      "listPage": "Filter bar across the top, primary grid below, 'Add new' button top-right of the grid",
      "editPage": "Two-column form, labels above inputs, Save and Cancel bottom-right",
      "deletePage": "Read-only summary of the record, warning panel, Confirm and Cancel",
      "messages": "Green success panel and red warning panel directly above the form or grid",
      "requiredFields": "Marked with a red asterisk, validated before save",
      "money": "Right-aligned, prefixed R, two decimals",
      "grids": "GridView, paging at 20 rows, sortable headers, action links in the last column"
    },
    "importantConstraint": "Controls are dragged onto the page in Design view for LAYOUT ONLY. Grids are bound in code-behind from the repository classes. Do NOT use SqlDataSource or ObjectDataSource wizards - that would put SQL back into the markup."
  },

  "roles": [
    { "id": "AD", "name": "Administrator", "notes": "Everything, including users and exchange rates" },
    { "id": "SU", "name": "Supervisor", "notes": "Everything except users and exchange rates" },
    { "id": "AG", "name": "Travel Agent", "notes": "Master data and trips, no reports" },
    { "id": "CL", "name": "Client", "notes": "Portal only, and only their own trips" }
  ],

  "lookups": {
    "Province": ["Eastern Cape", "Free State", "Gauteng", "KwaZulu-Natal", "Limpopo", "Mpumalanga", "Northern Cape", "North West", "Western Cape"],
    "AttractionCategory": ["Adventure", "Cultural", "Wildlife", "Historical", "Nature", "Entertainment", "Sightseeing"],
    "ExpenseCategory": ["Meals", "Fuel", "Entrance fees", "Shopping", "Other"],
    "RouteType": ["Flight", "Shuttle"],
    "ItineraryStatus": ["Draft", "Confirmed", "Cancelled", "Completed"],
    "BookingStatus": ["Confirmed", "Cancelled"],
    "VehicleBookingStatus": ["Confirmed", "Collected", "Returned", "Cancelled"]
  },

  "sections": [
    {
      "id": "account",
      "name": "Public and account",
      "order": 0,
      "inMenu": false,
      "pages": [
        {
          "id": "login",
          "name": "Login",
          "file": "Account/Login.aspx",
          "type": "auth",
          "roles": ["public"],
          "purpose": "Email and password, then send the user to their dashboard",
          "layout": "Centred card about 400px wide on an empty page with no menu",
          "fields": [
            { "name": "Email", "label": "Email address", "control": "TextBox", "inputType": "email", "required": true },
            { "name": "Password", "label": "Password", "control": "TextBox", "inputType": "password", "required": true },
            { "name": "RememberMe", "label": "Keep me signed in", "control": "CheckBox" }
          ],
          "actions": ["Sign in", "Create an account"],
          "states": ["empty", "invalid credentials warning", "account deactivated warning"]
        },
        {
          "id": "register",
          "name": "Register",
          "file": "Account/Register.aspx",
          "type": "form",
          "roles": ["public"],
          "purpose": "Client self-registration. Only ever creates a Client account",
          "layout": "Centred card, same width as Login",
          "fields": [
            { "name": "Name", "label": "First name", "control": "TextBox", "required": true, "maxLength": 60 },
            { "name": "Surname", "label": "Surname", "control": "TextBox", "required": true, "maxLength": 60 },
            { "name": "Email", "label": "Email address", "control": "TextBox", "inputType": "email", "required": true, "maxLength": 150, "unique": true },
            { "name": "ContactNumber", "label": "Contact number", "control": "TextBox", "maxLength": 20 },
            { "name": "Password", "label": "Password", "control": "TextBox", "inputType": "password", "required": true },
            { "name": "ConfirmPassword", "label": "Confirm password", "control": "TextBox", "inputType": "password", "required": true }
          ],
          "actions": ["Create account", "Back to sign in"],
          "states": ["empty", "email already registered warning", "passwords do not match warning"]
        },
        {
          "id": "denied",
          "name": "Access denied",
          "file": "Account/Denied.aspx",
          "type": "message",
          "roles": ["all"],
          "purpose": "Shown when a user opens something their role may not see",
          "layout": "Centred message with an icon and a Back to dashboard button",
          "actions": ["Back to dashboard"]
        }
      ]
    },

    {
      "id": "dashboard",
      "name": "Dashboard",
      "order": 1,
      "inMenu": true,
      "pages": [
        {
          "id": "dashboard",
          "name": "Dashboard",
          "file": "Default.aspx",
          "type": "dashboard",
          "roles": ["AD", "SU", "AG", "CL"],
          "purpose": "Landing page after login. Content differs per role",
          "layout": "Row of stat cards across the top, one or two grids below",
          "roleViews": [
            {
              "role": "CL",
              "statCards": ["My trips", "Next trip", "Total spent"],
              "grids": ["My trips - trip name, dates, status, total"],
              "actions": ["Plan a new trip"]
            },
            {
              "role": "AG",
              "statCards": ["My trips", "Unassigned trips waiting", "Cars out on hire"],
              "grids": ["My assigned trips", "Unassigned trips queue with a Claim button"],
              "actions": ["New itinerary"]
            },
            {
              "role": "AD|SU",
              "statCards": ["Trips this month", "Revenue this month", "Active clients", "Cars awaiting return"],
              "grids": ["Recent trips"],
              "actions": ["Open reports"]
            }
          ]
        }
      ]
    },

    {
      "id": "maintain",
      "name": "Maintain",
      "order": 2,
      "inMenu": true,
      "notes": "Master data. Every sub-section is the same three screens: list, add/edit, delete confirm. Build one set properly and the rest is copying.",
      "subSections": [
        {
          "id": "users",
          "name": "Users and access",
          "roles": ["AD"],
          "pages": [
            {
              "id": "users-list",
              "name": "User list",
              "file": "Maintain/Users/Default.aspx",
              "type": "list",
              "purpose": "All users, filter by role, active and inactive",
              "filters": [
                { "name": "Search", "label": "Name, surname or email", "control": "TextBox" },
                { "name": "RoleId", "label": "Role", "control": "DropDownList", "source": "Role" },
                { "name": "IncludeInactive", "label": "Show deactivated", "control": "CheckBox" }
              ],
              "grid": {
                "columns": ["Name", "Surname", "Email", "Contact number", "Role", "Active"],
                "actions": ["Edit", "Deactivate"]
              },
              "actions": ["Add user"]
            },
            {
              "id": "users-edit",
              "name": "Add / edit user",
              "file": "Maintain/Users/Edit.aspx",
              "type": "form",
              "purpose": "Details and role. Password is set here",
              "fields": [
                { "name": "Name", "label": "First name", "control": "TextBox", "required": true, "maxLength": 60 },
                { "name": "Surname", "label": "Surname", "control": "TextBox", "required": true, "maxLength": 60 },
                { "name": "Email", "label": "Email address", "control": "TextBox", "inputType": "email", "required": true, "maxLength": 150, "unique": true },
                { "name": "ContactNumber", "label": "Contact number", "control": "TextBox", "maxLength": 20 },
                { "name": "RoleId", "label": "Role", "control": "DropDownList", "source": "Role", "required": true },
                { "name": "Password", "label": "Password", "control": "TextBox", "inputType": "password", "note": "Leave blank when editing to keep the current password" },
                { "name": "IsActive", "label": "Account active", "control": "CheckBox", "default": true }
              ],
              "actions": ["Save", "Cancel"]
            },
            {
              "id": "users-delete",
              "name": "Deactivate user",
              "file": "Maintain/Users/Delete.aspx",
              "type": "confirm",
              "purpose": "Users are never deleted, only deactivated, because bookings record who captured them",
              "actions": ["Confirm deactivate", "Cancel"]
            }
          ]
        },
        {
          "id": "attractions",
          "name": "Attractions",
          "roles": ["AD", "SU", "AG"],
          "referenceImplementation": true,
          "pages": [
            {
              "id": "attractions-list",
              "name": "Attraction list",
              "file": "Maintain/Attractions/Default.aspx",
              "type": "list",
              "purpose": "Search by name, filter by category and province",
              "filters": [
                { "name": "Name", "label": "Name contains", "control": "TextBox" },
                { "name": "CategoryId", "label": "Category", "control": "DropDownList", "source": "AttractionCategory" },
                { "name": "ProvinceId", "label": "Province", "control": "DropDownList", "source": "Province" },
                { "name": "MaxRate", "label": "Maximum rate", "control": "TextBox", "inputType": "money" }
              ],
              "grid": {
                "columns": ["Name", "Category", "City", "Province", "Rate", "Capacity per slot", "Active"],
                "actions": ["Edit", "Time slots", "Delete"]
              },
              "actions": ["Add attraction", "Export to Excel"]
            },
            {
              "id": "attractions-edit",
              "name": "Add / edit attraction",
              "file": "Maintain/Attractions/Edit.aspx",
              "type": "form",
              "purpose": "All fields from Phase 2 Table 2",
              "fields": [
                { "name": "Name", "label": "Name", "control": "TextBox", "required": true, "maxLength": 120 },
                { "name": "CategoryId", "label": "Category", "control": "DropDownList", "source": "AttractionCategory" },
                { "name": "Description", "label": "Description", "control": "TextBox", "multiline": true, "maxLength": 1000 },
                { "name": "Address", "label": "Address", "control": "TextBox", "maxLength": 200 },
                { "name": "City", "label": "City", "control": "TextBox", "maxLength": 80 },
                { "name": "ProvinceId", "label": "Province", "control": "DropDownList", "source": "Province" },
                { "name": "Rate", "label": "Rate", "control": "TextBox", "inputType": "money", "required": true, "rule": "greater than zero" },
                { "name": "Quantity", "label": "Capacity per time slot (people)", "control": "TextBox", "inputType": "int", "required": true, "rule": "greater than zero" },
                { "name": "UnitOfMeasure", "label": "Unit of measure", "control": "TextBox", "placeholder": "per person, per group", "maxLength": 30 },
                { "name": "DurationMinutes", "label": "Duration (minutes)", "control": "TextBox", "inputType": "int" },
                { "name": "OperatingTimeStart", "label": "Opens at", "control": "TextBox", "inputType": "time" },
                { "name": "OperatingTimeEnd", "label": "Closes at", "control": "TextBox", "inputType": "time", "rule": "later than opens at" },
                { "name": "BestOperatingSeason", "label": "Best season", "control": "TextBox", "maxLength": 50 }
              ],
              "actions": ["Save", "Cancel"]
            },
            {
              "id": "attractions-timeslots",
              "name": "Time slots",
              "file": "Maintain/Attractions/TimeSlots.aspx",
              "type": "childList",
              "purpose": "Manage the slots for one attraction. Capacity is counted per slot",
              "header": "Shows the attraction name and its capacity per slot",
              "grid": { "columns": ["Starts", "Ends"], "actions": ["Delete"] },
              "inlineForm": [
                { "name": "TimeStart", "label": "Starts", "control": "TextBox", "inputType": "time", "required": true },
                { "name": "TimeEnd", "label": "Ends", "control": "TextBox", "inputType": "time", "required": true }
              ],
              "actions": ["Add slot", "Back to attractions"]
            },
            {
              "id": "attractions-delete",
              "name": "Delete attraction",
              "file": "Maintain/Attractions/Delete.aspx",
              "type": "confirm",
              "purpose": "Deactivates instead of deleting where bookings exist",
              "actions": ["Confirm delete", "Cancel"]
            }
          ]
        },
        {
          "id": "accommodation",
          "name": "Accommodation",
          "roles": ["AD", "SU", "AG"],
          "pages": [
            {
              "id": "accommodation-list",
              "name": "Accommodation list",
              "file": "Maintain/Accommodation/Default.aspx",
              "type": "list",
              "filters": [
                { "name": "Name", "label": "Name contains", "control": "TextBox" },
                { "name": "ProvinceId", "label": "Province", "control": "DropDownList", "source": "Province" },
                { "name": "MinStarRating", "label": "Minimum stars", "control": "DropDownList", "options": ["1", "2", "3", "4", "5"] },
                { "name": "MaxPrice", "label": "Maximum price per night", "control": "TextBox", "inputType": "money" }
              ],
              "grid": {
                "columns": ["Name", "Type", "City", "Province", "Stars", "Price per night", "Rooms", "Active"],
