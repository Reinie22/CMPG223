  <!--
    AUTO SET-UP THE DATABASE ON BUILD
    =================================
    Runs database/setup-database.ps1 before every build, with -IfMissing so it
    does nothing at all once the database exists. On a machine that has just
    cloned the repository it creates NkanyeziTours, runs 01-schema.sql and
    03-seed-data.sql, and presses on - so F5 works first time with no manual
    step.

    -IfMissing is not optional. Without it every build would run
    01-schema.sql, which DROPS every table, and a routine rebuild would wipe
    the data the whole group is working with.

    ContinueOnError: a developer with no SQL Server installed still gets a
    compiling project and the friendly message on the page, rather than a
    build they cannot run at all.
  -->
  <Target Name="EnsureDatabase" BeforeTargets="Build">
    <PropertyGroup>
      <SetupScript>$(MSBuildProjectDirectory)\..\..\..\database\setup-database.ps1</SetupScript>
    </PropertyGroup>
    <Exec Condition="Exists('$(SetupScript)')"
          Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(SetupScript)&quot; -IfMissing -NoConfigUpdate"
          ContinueOnError="true" />
  </Target>
