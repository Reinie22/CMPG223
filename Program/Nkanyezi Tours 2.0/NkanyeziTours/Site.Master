<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Site.Master.cs" Inherits="NkanyeziTours.SiteMaster" %>

<!DOCTYPE html>
<html lang="en">
<head runat="server">
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Nkanyezi Tours</title>
    <link rel="stylesheet" href="<%: ResolveUrl("~/Content/bootstrap/bootstrap.min.css") %>" />
    <link rel="stylesheet" href="<%: ResolveUrl("~/Content/site.css") %>" />
    <asp:ContentPlaceHolder ID="head" runat="server" />
</head>
<body>
    <form id="form1" runat="server">

        <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
            <div class="container">
                <a class="navbar-brand" href="<%: ResolveUrl("~/Portal/Discover.aspx") %>">Nkanyezi Tours</a>

                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="mainNav">
                    <ul class="navbar-nav me-auto">

                        <li class="nav-item">
                            <a class="nav-link" href="<%: ResolveUrl("~/Portal/Discover.aspx") %>">Discover</a>
                        </li>
                        <li class="nav-item" runat="server" id="navDashboard">
                            <a class="nav-link" href="<%: ResolveUrl("~/Default.aspx") %>"><asp:Literal ID="litDashboardLabel" runat="server" Text="Dashboard" /></a>
                        </li>
                        <li class="nav-item" runat="server" id="navMaintain">
                            <a class="nav-link" href="<%: ResolveUrl("~/Maintain/Attractions/Default.aspx") %>">Settings</a>
                        </li>
                        <li class="nav-item" runat="server" id="navItineraries">
                            <a class="nav-link" href="<%: ResolveUrl("~/Itineraries/Default.aspx") %>">Itineraries</a>
                        </li>
                        <li class="nav-item" runat="server" id="navReports">
                            <a class="nav-link" href="<%: ResolveUrl("~/Reports/Default.aspx") %>">Reports</a>
                        </li>
                    </ul>

                    <ul class="navbar-nav">
                        <asp:PlaceHolder ID="phSignedIn" runat="server">
                            <li class="nav-item">
                                <span class="navbar-text me-3">
                                    <asp:Literal ID="litUserName" runat="server" />
                                    <span class="badge bg-secondary ms-1">
                                        <asp:Literal ID="litRole" runat="server" />
                                    </span>
                                </span>
                            </li>
                            <li class="nav-item">
                                <asp:LinkButton ID="btnSignOut" ToolTip="Signs you out and returns to the sign-in screen." runat="server" CssClass="nav-link"
                                                OnClick="btnSignOut_Click" CausesValidation="false">Sign out</asp:LinkButton>
                            </li>
                        </asp:PlaceHolder>

                        <asp:PlaceHolder ID="phAnonymous" runat="server">
                            <li class="nav-item">
                                <a class="nav-link" href="<%: ResolveUrl("~/Account/Login.aspx") %>">Sign in</a>
                            </li>
                        </asp:PlaceHolder>
                    </ul>
                </div>
            </div>
        </nav>

        <asp:PlaceHolder ID="phBypassWarning" runat="server" Visible="false">
            <div class="bg-danger text-white text-center py-2 small fw-bold">
                LOGIN BYPASS IS ON &mdash; every visitor is signed in as
                <asp:Literal ID="litBypassUser" runat="server" />.
                Set BypassLogin to "false" in Web.config before the demo.
            </div>
        </asp:PlaceHolder>

        <main class="container py-4">
            <asp:ContentPlaceHolder ID="MainContent" runat="server" />
        </main>

        <footer class="border-top py-3 mt-4">
            <div class="container text-muted small">
                Group 6 &middot; CMPG223 &middot; Nkanyezi Tours
            </div>
        </footer>

        <div class="modal fade" id="confirmModal" tabindex="-1"
             aria-labelledby="confirmModalTitle" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title" id="confirmModalTitle">Please confirm</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal"
                                aria-label="Close"></button>
                    </div>
                    <div class="modal-body">
                        <p class="mb-0" id="confirmModalText"></p>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-outline-secondary"
                                data-bs-dismiss="modal">No, go back</button>
                        <button type="button" class="btn btn-danger" id="confirmModalOk">Yes, do it</button>
                    </div>
                </div>
            </div>
        </div>

        <script src="<%: ResolveUrl("~/Scripts/bootstrap.bundle.min.js") %>"></script>
        <script>
            (function () {
                var pending = null;
                var el = document.getElementById('confirmModal');
                var box = new bootstrap.Modal(el);
                var text = document.getElementById('confirmModalText');
                var ok = document.getElementById('confirmModalOk');

                document.addEventListener('click', function (e) {
                    var t = e.target.closest('[data-confirm]');
                    if (!t) return;

                    if (t.getAttribute('data-confirmed') === '1') {
                        t.removeAttribute('data-confirmed');
                        return;
                    }

                    e.preventDefault();
                    e.stopPropagation();

                    pending = t;
                    text.textContent = t.getAttribute('data-confirm');
                    box.show();
                }, true);

                ok.addEventListener('click', function () {
                    if (!pending) return;
                    var t = pending;
                    pending = null;
                    box.hide();
                    t.setAttribute('data-confirmed', '1');
                    t.click();
                });

                el.addEventListener('hidden.bs.modal', function () { pending = null; });
            })();
        </script>
    </form>
</body>
</html>
