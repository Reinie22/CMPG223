<?xml version="1.0" encoding="utf-8"?>
<!--
  Nkanyezi Tours - Web.config

  In the old ASP.NET Core project, three separate things lived in Program.cs:
  the connection string, the login cookie setup, and which roles may open which
  pages. In Web Forms all three live in this file. Nothing configures them in
  code, so this is the first place to look when a page is unexpectedly open or
  unexpectedly blocked.
-->
<configuration>

  <!--
    THE CONNECTION STRING
    ====================
    Read in code by ConfigurationManager.ConnectionStrings["NkanyeziDb"].

    If SQL Server is installed differently on your machine, change it HERE and
    nowhere else. The three usual values are:

      LocalDB (ships with Visual Studio, nothing to install)
        Server=(localdb)\MSSQLLocalDB;Database=NkanyeziTours;Trusted_Connection=True;TrustServerCertificate=True;

      SQL Server Express
        Server=localhost\SQLEXPRESS;Database=NkanyeziTours;Trusted_Connection=True;TrustServerCertificate=True;

      Default instance
        Server=localhost;Database=NkanyeziTours;Trusted_Connection=True;TrustServerCertificate=True;

    Never put a password in here. This file IS committed to git.
  -->
  <connectionStrings>
    <add name="NkanyeziDb"
         connectionString="Server=(localdb)\MSSQLLocalDB;Database=NkanyeziTours;Trusted_Connection=True;TrustServerCertificate=True;"
         providerName="System.Data.SqlClient" />
  </connectionStrings>

  <system.web>
    <compilation debug="true" targetFramework="4.8" />
    <httpRuntime targetFramework="4.8" />

    <!--
      LOGIN
      =====
      The Web Forms replacement for cookie authentication middleware.

      Forms authentication writes an encrypted cookie once somebody signs in,
      and the browser sends it back on every later request. timeout is in
      minutes; slidingExpiration restarts the clock while they keep working, so
      an agent is not thrown out halfway through capturing a booking.
    -->
    <authentication mode="Forms">
      <forms name="NkanyeziAuth"
             loginUrl="~/Account/Login.aspx"
             defaultUrl="~/Default.aspx"
             timeout="480"
             slidingExpiration="true"
             protection="All"
             cookieless="UseCookies"
             requireSSL="false" />
    </authentication>

    <!--
      WHO MAY OPEN WHAT - the default
      ==============================
      "deny users=?" means anonymous visitors are refused everywhere. The ?
      character means "not signed in".

      This is deliberately the safe way round: a page somebody forgets to
      protect is protected anyway, instead of being wide open. The pages that
      really are public are opened up one at a time in the <location> blocks
      further down.
    -->
    <authorization>
      <deny users="?" />
    </authorization>

    <pages enableViewStateMac="true" viewStateEncryptionMode="Auto">
      <namespaces>
        <add namespace="System" />
        <add namespace="System.Collections.Generic" />
        <add namespace="System.Linq" />
        <add namespace="System.Web" />
        <add namespace="System.Web.UI" />
        <add namespace="System.Web.UI.WebControls" />
        <add namespace="Nkanyezi.Models" />
      </namespaces>
    </pages>

    <!--
      Errors are shown in full because this is a development project that runs
      on your own machine and is demonstrated locally. Seeing the real message
      and line number is worth far more to you than hiding it.

      If this were ever put on a public server, change this to
      mode="RemoteOnly" and add an Error.aspx page - a stack trace tells an
      attacker a great deal about how a system is built.
    -->
    <customErrors mode="Off" />

    <sessionState mode="InProc" timeout="480" />
  </system.web>

  <!--
    THE PUBLIC PAGES
    ================
    Everything under Account must be reachable by somebody who is not signed in,
    otherwise they could never reach the login page to sign in - the classic
    circular lockout.

    Portal is public on purpose: the whole point of the client portal is that a
    prospective client can browse attractions and see roughly what a flight
    costs WITHOUT phoning an agent. That is the problem the project exists to
    solve.
  -->
  <location path="Account">
    <system.web>
      <authorization>
        <allow users="*" />
      </authorization>
    </system.web>
  </location>

  <location path="Portal">
    <system.web>
      <authorization>
        <allow users="*" />
      </authorization>
    </system.web>
  </location>

  <location path="Content">
    <system.web>
      <authorization>
        <allow users="*" />
      </authorization>
    </system.web>
  </location>

  <location path="Scripts">
    <system.web>
      <authorization>
        <allow users="*" />
      </authorization>
    </system.web>
  </location>

  <!--
    ROLE RULES
    ==========
    Order matters and the FIRST match wins. Each block allows the roles named
    and then denies everybody else, so a Client who types a Maintain URL into
    the address bar is sent to the access denied page.

    The role names must match the RoleName column in the Role table exactly.
    They are also in Models/AppUser.cs as the RoleNames constants - if you
    change one, change both.
  -->
  <location path="Maintain/Users">
    <system.web>
      <authorization>
        <allow roles="Administrator" />
        <deny users="*" />
      </authorization>
    </system.web>
  </location>

  <location path="Maintain/Rates">
    <system.web>
      <authorization>
        <allow roles="Administrator" />
        <deny users="*" />
      </authorization>
    </system.web>
  </location>

  <location path="Maintain">
    <system.web>
      <authorization>
        <allow roles="Administrator, Supervisor, Travel Agent" />
        <deny users="*" />
      </authorization>
    </system.web>
  </location>

  <location path="Itineraries">
    <system.web>
      <authorization>
        <allow roles="Administrator, Supervisor, Travel Agent" />
        <deny users="*" />
      </authorization>
    </system.web>
  </location>

  <location path="Reports">
    <system.web>
      <authorization>
        <allow roles="Administrator, Supervisor" />
        <deny users="*" />
      </authorization>
    </system.web>
  </location>

  <system.webServer>
    <!-- Let ASP.NET's own error page through instead of IIS replacing it
         with a blank page. Without this, an unhandled error can arrive as an
         empty 500 with nothing to go on. -->
    <httpErrors errorMode="Detailed" existingResponse="PassThrough" />
    <validation validateIntegratedModeConfiguration="false" />
    <defaultDocument>
      <files>
        <clear />
        <add value="Default.aspx" />
      </files>
    </defaultDocument>
  </system.webServer>

</configuration>
