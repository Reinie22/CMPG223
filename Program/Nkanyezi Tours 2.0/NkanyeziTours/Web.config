<?xml version="1.0" encoding="utf-8"?>
<!--
  Nkanyezi Tours - Web.config

  In the old ASP.NET Core project, three separate things lived in Program.cs:
  the connection string, the login cookie setup, and which roles may open which
  pages. In Web Forms all three live in this file. Nothing configures them in
  code, so this is the first place to look when a page is unexpectedly open or
  unexpectedly blocked.
-->
<configuration>

  <!--
    THE CONNECTION STRING
    ====================
    Read in code by ConfigurationManager.ConnectionStrings["NkanyeziDb"].

    If SQL Server is installed differently on your machine, change it HERE and
    nowhere else. The three usual values are:

      LocalDB (ships with Visual Studio, nothing to install)
        Server=(localdb)\MSSQLLocalDB;Database=NkanyeziTours;Trusted_Connection=True;TrustServerCertificate=True;

      SQL Server Express
        Server=localhost\SQLEXPRESS;Database=NkanyeziTours;Trusted_Connection=True;TrustServerCertificate=True;

      Default instance
        Server=localhost;Database=NkanyeziTours;Trusted_Connection=True;TrustServerCertificate=True;

    Never put a password in here. This file IS committed to git.
  -->
  <connectionStrings>
    <add name="NkanyeziDb"
         connectionString="Server=(localdb)\MSSQLLocalDB;Database=NkanyeziTours;Trusted_Connection=True;TrustServerCertificate=True;"
         providerName="System.Data.SqlClient" />
  </connectionStrings>

  <!--
    TESTING SWITCH - LOGIN BYPASS
    =============================
    While this is "true", nobody has to sign in. Every request arrives already
    signed in as the first Administrator in the database, so every page and
    every menu item can be opened and tested without a working login.

    The login screen itself is untouched and still works - go to
    ~/Account/Login.aspx and sign in normally if you want to test as a
    different role. A real login overrides the bypass for that browser.

    A red warning strip appears across the top of every page while this is on,
    so it cannot be left on by accident.

    TURN THIS BACK TO "false" BEFORE THE DEMO AND BEFORE MARKING. It switches
    off every authorisation rule in this file in one go.
  -->
  <appSettings>
    <add key="BypassLogin" value="true" />
  </appSettings>

  <system.web>
    <compilation debug="true" targetFramework="4.8" />
    <httpRuntime targetFramework="4.8" maxRequestLength="10240" />

    <!--
      NUMBER AND DATE FORMAT - pinned on purpose
      ==========================================
      Without this line, every machine uses whatever Windows is set to. On a
      South African install that is af-ZA or en-ZA, and BOTH of those use a
      COMMA as the decimal separator, not a full stop.

      That breaks pages in a way that looks nothing like a formatting problem.
      The rate validator on Maintain/Attractions/Edit.aspx is written as

          Type="Currency" MinimumValue="0.01"

      and ASP.NET parses that "0.01" using the current culture. Under a comma
      culture it is not a valid number at all, so the whole page dies at
      start-up with

          The value '0.01' of the MinimumValue property of 'rvRate'
          cannot be converted to type 'Currency'.

      It works perfectly for anyone whose Windows is set to the United States
      and fails for everyone else, which is the worst kind of bug to chase.

      en-GB is chosen rather than en-ZA because en-ZA is one of the comma
      cultures and would not fix anything. en-GB gives a full stop for decimals,
      which is what the code already assumes - Edit.aspx.cs parses the rate with
      CultureInfo.InvariantCulture - and keeps day/month/year dates.

      Dates are not affected either way: every date box is parsed with
      TryParseExact "yyyy-MM-dd" against InvariantCulture, so it does not matter
      what the culture says.
    -->
    <globalization culture="en-GB" uiCulture="en-GB" />

    <!--
      LOGIN
      =====
      The Web Forms replacement for cookie authentication middleware.

      Forms authentication writes an encrypted cookie once somebody signs in,
      and the browser sends it back on every later request. timeout is in
      minutes; slidingExpiration restarts the clock while they keep working, so
      an agent is not thrown out halfway through capturing a booking.
    -->
    <authentication mode="Forms">
      <forms name="NkanyeziAuth"
             loginUrl="~/Account/Login.aspx"
             defaultUrl="~/Default.aspx"
             timeout="480"
             slidingExpiration="true"
             protection="All"
             cookieless="UseCookies"
             requireSSL="false" />
    </authentication>

    <!--
      WHO MAY OPEN WHAT - the default
      ==============================
      "deny users=?" means anonymous visitors are refused everywhere. The ?
      character means "not signed in".

      This is deliberately the safe way round: a page somebody forgets to
      protect is protected anyway, instead of being wide open. The pages that
      really are public are opened up one at a time in the <location> blocks
      further down.
    -->
    <authorization>
      <deny users="?" />
    </authorization>

    <pages enableViewStateMac="true" viewStateEncryptionMode="Auto">
      <namespaces>
        <add namespace="System" />
        <add namespace="System.Collections.Generic" />
        <add namespace="System.Linq" />
        <add namespace="System.Web" />
        <add namespace="System.Web.UI" />
        <add namespace="System.Web.UI.WebControls" />
        <add namespace="Nkanyezi.Models" />
      </namespaces>
    </pages>

    <!--
      Users never see a stack trace. Any unhandled error shows the friendly
      Error.aspx page, and a missing page shows NotFound.aspx. The full error,
      with the address that caused it, is written to App_Data\Logs\errors.log
      by Application_Error in Global.asax.cs - look there when something fails.

      To see the yellow ASP.NET error screen again while debugging, change
      mode="On" to mode="Off".
    -->
    <customErrors mode="On" defaultRedirect="~/Error.aspx" redirectMode="ResponseRewrite">
      <error statusCode="404" redirect="~/NotFound.aspx" />
    </customErrors>

    <sessionState mode="InProc" timeout="480" />
  </system.web>

  <!--
    THE PUBLIC PAGES
    ================
    Everything under Account must be reachable by somebody who is not signed in,
    otherwise they could never reach the login page to sign in - the classic
    circular lockout.

    Portal is public on purpose: the whole point of the client portal is that a
    prospective client can browse attractions and see roughly what a flight
    costs WITHOUT phoning an agent. That is the problem the project exists to
    solve.
  -->
  <location path="Account">
    <system.web>
      <authorization>
        <allow users="*" />
      </authorization>
    </system.web>
  </location>

  <location path="Default.aspx">
    <system.web>
      <authorization>
        <allow users="*" />
      </authorization>
    </system.web>
  </location>

  <location path="Error.aspx">
    <system.web>
      <authorization>
        <allow users="*" />
      </authorization>
    </system.web>
  </location>

  <location path="NotFound.aspx">
    <system.web>
      <authorization>
        <allow users="*" />
      </authorization>
    </system.web>
  </location>

  <location path="Uploads">
    <system.web>
      <authorization>
        <allow users="*" />
      </authorization>
    </system.web>
  </location>

  <location path="Portal">
    <system.web>
      <authorization>
        <allow users="*" />
      </authorization>
    </system.web>
  </location>

  <location path="Content">
    <system.web>
      <authorization>
        <allow users="*" />
      </authorization>
    </system.web>
  </location>

  <location path="Scripts">
    <system.web>
      <authorization>
        <allow users="*" />
      </authorization>
    </system.web>
  </location>

  <!--
    ROLE RULES
    ==========
    Order matters and the FIRST match wins. Each block allows the roles named
    and then denies everybody else, so a Client who types a Maintain URL into
    the address bar is sent to the access denied page.

    The role names must match the RoleName column in the Role table exactly.
    They are also in Models/AppUser.cs as the RoleNames constants - if you
    change one, change both.
  -->
  <location path="Maintain/Users">
    <system.web>
      <authorization>
        <allow roles="Administrator" />
        <deny users="*" />
      </authorization>
    </system.web>
  </location>

  <location path="Maintain/Rates">
    <system.web>
      <authorization>
        <allow roles="Administrator" />
        <deny users="*" />
      </authorization>
    </system.web>
  </location>

  <location path="Maintain">
    <system.web>
      <authorization>
        <allow roles="Administrator, Supervisor, Travel Agent" />
        <deny users="*" />
      </authorization>
    </system.web>
  </location>

  <!--
    The client's own screen. Only a Client may open it, because it creates a
    trip belonging to whoever is signed in - a staff member using it would
    file a trip against themselves as the client.
  -->
  <location path="Trips">
    <system.web>
      <authorization>
        <allow roles="Client" />
        <deny users="*" />
      </authorization>
    </system.web>
  </location>

  <!--
    Allocation is management's job, not an agent's - an agent self-serves from
    the queue instead. This block MUST stay above the Itineraries folder rule
    below it, because the first matching location wins.
  -->
  <location path="Itineraries/Assign.aspx">
    <system.web>
      <authorization>
        <allow roles="Administrator, Supervisor" />
        <deny users="*" />
      </authorization>
    </system.web>
  </location>

  <location path="Itineraries">
    <system.web>
      <authorization>
        <allow roles="Administrator, Supervisor, Travel Agent" />
        <deny users="*" />
      </authorization>
    </system.web>
  </location>

  <location path="Reports">
    <system.web>
      <authorization>
        <allow roles="Administrator, Supervisor" />
        <deny users="*" />
      </authorization>
    </system.web>
  </location>

  <system.webServer>
    <!-- Let ASP.NET's own error page through instead of IIS replacing it
         with a blank page. Without this, an unhandled error can arrive as an
         empty 500 with nothing to go on. -->
    <httpErrors errorMode="Detailed" existingResponse="PassThrough" />
    <validation validateIntegratedModeConfiguration="false" />
    <security>
      <requestFiltering>
        <requestLimits maxAllowedContentLength="10485760" />
      </requestFiltering>
    </security>
    <defaultDocument>
      <files>
        <clear />
        <add value="Default.aspx" />
      </files>
    </defaultDocument>
  </system.webServer>

  <runtime>
    <assemblyBinding xmlns="urn:schemas-microsoft-com:asm.v1">
      <dependentAssembly>
        <assemblyIdentity name="System.Buffers" publicKeyToken="cc7b13ffcd2ddd51" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-4.0.3.0" newVersion="4.0.3.0" />
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="System.Memory" publicKeyToken="cc7b13ffcd2ddd51" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-4.0.1.2" newVersion="4.0.1.2" />
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="System.Numerics.Vectors" publicKeyToken="b03f5f7f11d50a3a" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-4.1.4.0" newVersion="4.1.4.0" />
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="System.Runtime.CompilerServices.Unsafe" publicKeyToken="b03f5f7f11d50a3a" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-6.0.0.0" newVersion="6.0.0.0" />
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="System.Security.Cryptography.Pkcs" publicKeyToken="b03f5f7f11d50a3a" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-8.0.0.1" newVersion="8.0.0.1" />
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="System.Diagnostics.DiagnosticSource" publicKeyToken="cc7b13ffcd2ddd51" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-8.0.0.1" newVersion="8.0.0.1" />
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="System.Threading.Tasks.Extensions" publicKeyToken="cc7b13ffcd2ddd51" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-4.2.0.1" newVersion="4.2.0.1" />
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="Microsoft.Bcl.AsyncInterfaces" publicKeyToken="cc7b13ffcd2ddd51" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-8.0.0.0" newVersion="8.0.0.0" />
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="Microsoft.Extensions.DependencyInjection.Abstractions" publicKeyToken="adb9793829ddae60" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-8.0.0.2" newVersion="8.0.0.2" />
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="Microsoft.Extensions.Logging.Abstractions" publicKeyToken="adb9793829ddae60" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-8.0.0.2" newVersion="8.0.0.2" />
      </dependentAssembly>
    </assemblyBinding>
  </runtime>

</configuration>
