<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Nkanyezi_Tours</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- Talks to SQL Server. If this version does not restore, right click the
         project, choose Manage NuGet Packages, and install the latest
         Microsoft.Data.SqlClient. -->
    <PackageReference Include="Microsoft.Data.SqlClient" Version="6.0.2" />
    <!-- Password hashing. See Data/PasswordHasher.cs -->
    <PackageReference Include="BCrypt.Net-Next" Version="4.0.3" />
  </ItemGroup>

</Project>
