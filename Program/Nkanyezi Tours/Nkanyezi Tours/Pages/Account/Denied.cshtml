@page
@using Microsoft.AspNetCore.Authorization
@attribute [AllowAnonymous]
@{
    ViewData["Title"] = "Access denied";
}

<div class="row justify-content-center">
    <div class="col-md-6 text-center py-5">
        <h1 class="h3">Access denied</h1>
        <p class="text-muted">
            Your account does not have permission to open that page.
            If you believe it should, speak to the system administrator.
        </p>
        <a class="btn btn-primary" href="/">Back to the dashboard</a>
        <a class="btn btn-outline-secondary" href="/Account/Logout">Sign in as someone else</a>
    </div>
</div>
