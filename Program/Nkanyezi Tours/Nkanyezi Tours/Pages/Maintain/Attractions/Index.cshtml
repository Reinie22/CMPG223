@page
@model Nkanyezi_Tours.Pages.Maintain.Attractions.IndexModel
@{
    ViewData["Title"] = "Attractions";
}

<h1>Attractions</h1>
<p class="text-muted">Maintain the attractions that can be added to a client's itinerary.</p>

@if (Model.ErrorMessage != null)
{
    <div class="alert alert-danger">
        <strong>Database error</strong>
        <p class="mb-0">@Model.ErrorMessage</p>
    </div>
}

<!-- Search. A plain GET form, so the filters end up in the address bar and the
     page can be refreshed or shared without losing them. -->
<form method="get" class="row g-2 align-items-end mb-3">
    <div class="col-md-4">
        <label class="form-label" for="SearchName">Name</label>
        <input class="form-control" id="SearchName" name="SearchName"
               value="@Model.SearchName" placeholder="Search by name" />
    </div>

    <div class="col-md-3">
        <label class="form-label" for="CategoryId">Category</label>
        <select class="form-select" id="CategoryId" name="CategoryId">
            <option value="">All categories</option>
            @foreach (var c in Model.Categories)
            {
                <option value="@c.Id" selected="@(Model.CategoryId == c.Id)">@c.Name</option>
            }
        </select>
    </div>

    <div class="col-md-3">
        <label class="form-label" for="ProvinceId">Province</label>
        <select class="form-select" id="ProvinceId" name="ProvinceId">
            <option value="">All provinces</option>
            @foreach (var p in Model.Provinces)
            {
                <option value="@p.Id" selected="@(Model.ProvinceId == p.Id)">@p.Name</option>
            }
        </select>
    </div>

    <div class="col-md-2 d-flex gap-2">
        <button type="submit" class="btn btn-primary">Search</button>
        <a href="/Maintain/Attractions" class="btn btn-outline-secondary">Clear</a>
    </div>
</form>

<div class="d-flex justify-content-between align-items-center mb-2">
    <span class="text-muted">@Model.Attractions.Count attraction(s)</span>
    <a class="btn btn-success" href="/Maintain/Attractions/Edit">Add attraction</a>
</div>

@if (!Model.Attractions.Any() && Model.ErrorMessage == null)
{
    <div class="alert alert-info">
        No attractions found. Try clearing the search, or add a new one.
    </div>
}
else
{
    <table class="table table-striped table-hover align-middle">
        <thead>
            <tr>
                <th>Name</th>
                <th>Category</th>
                <th>Location</th>
                <th class="text-end">Rate</th>
                <th class="text-end">Capacity per slot</th>
                <th>Best season</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var a in Model.Attractions)
            {
                <tr>
                    <td>
                        <strong>@a.Name</strong>
                        @if (!a.IsActive)
                        {
                            <span class="badge bg-secondary ms-1">Inactive</span>
                        }
                    </td>
                    <td>@a.CategoryName</td>
                    <td>@a.Location</td>
                    <td class="text-end">R @a.Rate.ToString("N2")</td>
                    <td class="text-end">@a.Quantity people</td>
                    <td>@a.BestOperatingSeason</td>
                    <td class="text-end">
                        <a class="btn btn-sm btn-outline-primary"
                           href="/Maintain/Attractions/Edit?id=@a.AttractionId">Edit</a>
                        <a class="btn btn-sm btn-outline-danger"
                           href="/Maintain/Attractions/Delete?id=@a.AttractionId">Delete</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
